<Application
    x:Class="YYReader.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="YYSpacingSmall">8</x:Double>
            <x:Double x:Key="YYSpacingMedium">16</x:Double>
            <x:Double x:Key="YYSpacingLarge">28</x:Double>
            <x:Double x:Key="YYSectionSpacing">20</x:Double>
            <x:Double x:Key="YYTitleBarButtonSize">36</x:Double>
            <x:Double x:Key="YYTitleBarHeight">44</x:Double>
            <x:Double x:Key="YYToolbarHeight">36</x:Double>
            <x:Double x:Key="YYReaderChromeTextOpacity">0.56</x:Double>
            <x:Double x:Key="YYSeparatorOpacity">0.22</x:Double>
            <x:Double x:Key="YYReaderFooterSpacing">28</x:Double>
            <CornerRadius x:Key="YYCornerSmall">6</CornerRadius>
            <CornerRadius x:Key="YYCornerMedium">8</CornerRadius>
            <Thickness x:Key="YYPagePadding">40,28,40,28</Thickness>
            <Thickness x:Key="YYCardPadding">20</Thickness>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
            </Style>
            <Style x:Key="YYToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="{StaticResource YYToolbarHeight}" />
                <Setter Property="CornerRadius" Value="{StaticResource YYCornerSmall}" />
                <Setter Property="Padding" Value="12,6" />
            </Style>
            <Style x:Key="YYSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="YYSecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.62" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
