<Page
    x:Class="YYReader.Windows.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YYReader.Windows.Views"
    xmlns:models="using:YYReader.Windows.Core.Models">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LibraryHeroBrush" Color="#E8EEE9" />
                    <SolidColorBrush x:Key="LibraryAccentBrush" Color="#365E51" />
                    <SolidColorBrush x:Key="LibraryMutedBrush" Color="#63756B" />
                    <SolidColorBrush x:Key="LibraryCoverInk" Color="#FFF9EC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="LibraryHeroBrush" Color="#24342F" />
                    <SolidColorBrush x:Key="LibraryAccentBrush" Color="#B9D8C5" />
                    <SolidColorBrush x:Key="LibraryMutedBrush" Color="#AEC0B4" />
                    <SolidColorBrush x:Key="LibraryCoverInk" Color="#FFF9EC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="LibraryHeroBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LibraryAccentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LibraryMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LibraryCoverInk" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Background="Transparent" KeyDown="LibraryPage_KeyDown" IsTabStop="True">
        <Grid x:Name="LibraryShell" MaxWidth="1180" HorizontalAlignment="Stretch" Padding="40,24,40,18"
              RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="20" SizeChanged="LibraryShell_SizeChanged">
            <Grid x:Name="LibraryToolbar" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Button x:Name="AddBookButton" Grid.Column="1" Content="＋ 添加小说"
                        Style="{StaticResource AccentButtonStyle}">
                    <Button.Flyout>
                        <Flyout x:Name="AddBookFlyout">
                            <StackPanel Width="420" Spacing="12">
                                <TextBlock Text="添加小说" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="粘贴章节页或目录页 URL" Style="{StaticResource YYSecondaryTextStyle}" />
                                <TextBox x:Name="UrlTextBox" PlaceholderText="https://…" KeyDown="UrlTextBox_KeyDown" />
                                <Button Content="导入本地 TXT…" Click="ImportLocalText_Click" />
                                <Button Content="添加到书架" HorizontalAlignment="Right"
                                        Style="{StaticResource AccentButtonStyle}" Click="AddUrl_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="2" Width="{StaticResource YYTitleBarButtonSize}" Style="{StaticResource YYToolbarButtonStyle}" ToolTipService.ToolTip="更多">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="文件夹同步" Click="FolderSync_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="导入书架" Click="ImportBookshelf_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="复制书架导出 JSON" Click="CopyBookshelfExport_Click" />
                            <MenuFlyoutItem Text="导出为 .yyreader 文件" Click="SaveBookshelfExport_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="关于 YYReader" Click="About_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,2">
                <StackPanel Spacing="7">
                    <TextBlock Text="A LITTLE TIME, A GOOD STORY" FontSize="10" CharacterSpacing="180"
                               Foreground="{ThemeResource LibraryAccentBrush}" />
                    <TextBlock Text="我的书房" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="把时间，留给好故事。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel x:Name="LibraryStats" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="28">
                    <StackPanel Spacing="4"><TextBlock x:Name="TotalBooksText" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="书架藏书" FontSize="12" Opacity="0.6" /></StackPanel>
                    <Border Width="1" Height="36" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <StackPanel Spacing="4"><TextBlock x:Name="OfflineBooksText" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="有离线正文" FontSize="12" Opacity="0.6" /></StackPanel>
                    <StackPanel Spacing="4"><TextBlock x:Name="LocalBooksText" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="本地 TXT" FontSize="12" Opacity="0.6" /></StackPanel>
                </StackPanel>
            </Grid>

            <Border x:Name="FeaturedBookPanel" Grid.Row="1" CornerRadius="16" Padding="26,24"
                    Background="{ThemeResource LibraryHeroBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="26">
                    <Border x:Name="FeaturedCover" Width="104" Height="142" CornerRadius="3,9,9,3" Background="#365E51">
                        <Grid Padding="16,14" RowDefinitions="Auto,*,Auto">
                            <Border Width="1" Background="#40FFFFFF" HorizontalAlignment="Left" Margin="-10,-14,0,-14" Grid.RowSpan="3" />
                            <TextBlock Text="YY / LIBRARY" FontSize="8" CharacterSpacing="80" Foreground="{ThemeResource LibraryCoverInk}" Opacity="0.7" />
                            <TextBlock x:Name="FeaturedMonogram" Grid.Row="1" FontFamily="SimSun" FontSize="42" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource LibraryCoverInk}" />
                            <StackPanel Grid.Row="2" Spacing="6"><Border Height="1" Background="#50FFFFFF" /><TextBlock Text="藏 于 书 房" FontSize="9" Foreground="{ThemeResource LibraryCoverInk}" Opacity="0.8" /></StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8A4;" FontSize="12" Foreground="{ThemeResource LibraryAccentBrush}" /><TextBlock Text="继续上次的阅读" FontSize="12" Foreground="{ThemeResource LibraryAccentBrush}" /></StackPanel>
                        <TextBlock x:Name="FeaturedTitle" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FeaturedAuthor" FontSize="13" Foreground="{ThemeResource LibraryMutedBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FeaturedChapter" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FeaturedProgress" FontSize="11" Foreground="{ThemeResource LibraryMutedBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="FeaturedAction" Grid.Column="2" Width="150" VerticalAlignment="Center" Spacing="12">
                        <Button x:Name="FeaturedOpenButton" Content="继续阅读  →" HorizontalAlignment="Stretch" Padding="18,11" CornerRadius="8"
                                Style="{StaticResource AccentButtonStyle}" Click="OpenBook_Click" />
                        <ProgressBar x:Name="FeaturedProgressBar" Minimum="0" Maximum="1" Height="4" Foreground="{ThemeResource LibraryAccentBrush}" />
                        <TextBlock x:Name="FeaturedProgressLabel" FontSize="11" Foreground="{ThemeResource LibraryMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="我的书架" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center"><TextBlock x:Name="BookCountText" FontSize="12" Opacity="0.65" /></Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="BookFilter" SelectedIndex="0" Width="124" SelectionChanged="BookFilter_SelectionChanged" AutomationProperties.Name="书架筛选">
                        <ComboBoxItem Content="全部小说" /><ComboBoxItem Content="本地 TXT" /><ComboBoxItem Content="有离线正文" />
                    </ComboBox>
                    <TextBox x:Name="BookSearchBox" Width="220" PlaceholderText="搜索书名或作者" TextChanged="BookSearchBox_TextChanged" AutomationProperties.Name="搜索书架" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" MinHeight="80">
                <ListView x:Name="BookListView" SelectionMode="Single" IsItemClickEnabled="False"
                          SelectionChanged="BookListView_SelectionChanged" DoubleTapped="BookListView_DoubleTapped" KeyDown="BookListView_KeyDown"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="CornerRadius" Value="12" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Book">
                            <Grid Padding="16,13" ColumnDefinitions="64,*,Auto" ColumnSpacing="18" Background="Transparent" CornerRadius="12">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="打开" Tag="{x:Bind}" Click="OpenBookMenu_Click" />
                                        <MenuFlyoutItem Text="编辑书籍信息" Tag="{x:Bind}" Click="EditBookMetadata_Click" />
                                        <MenuFlyoutItem IsEnabled="{x:Bind SupportsWebOperations}" Text="刷新目录" Tag="{x:Bind}" Click="RefreshBookCatalog_Click" />
                                        <MenuFlyoutItem IsEnabled="{x:Bind SupportsWebOperations}" Text="下载全部章节" Tag="{x:Bind}" Click="DownloadAllBook_Click" />
                                        <MenuFlyoutItem IsEnabled="{x:Bind SupportsWebOperations}" Text="删除离线缓存" Tag="{x:Bind}" Click="ClearBookCache_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="删除小说" Tag="{x:Bind}" Click="DeleteBook_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Border Width="64" Height="82" CornerRadius="2,6,6,2" Background="{x:Bind local:LibraryPage.BookCoverBrush(SourceBookUrl)}">
                                    <Grid Padding="10,8" RowDefinitions="Auto,*,Auto">
                                        <Border Grid.RowSpan="3" Width="1" Background="#40FFFFFF" HorizontalAlignment="Left" Margin="-6,-8,0,-8" />
                                        <TextBlock Text="YY READER" FontSize="6" CharacterSpacing="90" Foreground="{ThemeResource LibraryCoverInk}" Opacity="0.65" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind Monogram}" FontFamily="SimSun" FontSize="29" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource LibraryCoverInk}" />
                                        <Border Grid.Row="2" Height="1" Background="#50FFFFFF" Margin="0,0,6,3" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind local:LibraryPage.BookSubtitle(Author, IsLocalText)}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"><FontIcon Glyph="&#xE8A4;" FontSize="11" Opacity="0.5" /><TextBlock Grid.Column="1" Text="{x:Bind CurrentChapterTitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" /></Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Width="112" VerticalAlignment="Center" Spacing="8" Margin="8,0,0,0">
                                    <TextBlock Text="{x:Bind local:LibraryPage.ChapterProgress(CurrentProgress)}" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ProgressBar Value="{x:Bind CurrentProgress}" Minimum="0" Maximum="1" Height="3" Foreground="{ThemeResource LibraryAccentBrush}" />
                                    <Button Content="阅读  →" Tag="{x:Bind}" Click="OpenBook_Click" HorizontalAlignment="Right" Padding="10,4" FontSize="12" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind local:LibraryPage.OpenBookLabel(Title)}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE736;" FontSize="36" Foreground="{ThemeResource LibraryAccentBrush}" />
                    <TextBlock x:Name="EmptyTitle" Text="你的下一段故事，从这里开始" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyDescription" Text="添加网页小说，或导入一本本地 TXT。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <Button Content="导入本地 TXT" Click="ImportLocalText_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><FontIcon Glyph="&#xE8F1;" FontSize="12" Opacity="0.45" /><TextBlock Text="双击书籍或按 Enter 开始阅读" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                <Button Grid.Column="1" Click="FolderSync_Click" Background="Transparent" BorderThickness="0" Padding="8,4" ToolTipService.ToolTip="文件夹同步设置">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE895;" FontSize="12" Foreground="{ThemeResource LibraryAccentBrush}" /><TextBlock x:Name="SyncSummaryText" Text="文件夹同步" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                </Button>
            </Grid>
            <InfoBar x:Name="StatusInfoBar" Grid.Row="5" IsOpen="False" IsClosable="True" Closed="StatusInfoBar_Closed" />
        </Grid>
    </Grid>
</Page>
