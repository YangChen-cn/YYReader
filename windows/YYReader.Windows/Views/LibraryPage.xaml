<Page
    x:Class="YYReader.Windows.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YYReader.Windows.Core.Models">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid MaxWidth="1040"
              HorizontalAlignment="Stretch"
              Padding="40,30,40,24"
              RowDefinitions="Auto,Auto,Auto,*"
              RowSpacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="书架" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="你的小说都保存在这台电脑上" Opacity="0.58" FontSize="13" />
            </StackPanel>

            <Border Grid.Row="1"
                    Padding="16"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox x:Name="UrlTextBox"
                             MinHeight="38"
                             PlaceholderText="粘贴小说章节或目录 URL"
                             KeyDown="UrlTextBox_KeyDown" />
                    <Button Grid.Column="1"
                            Content="添加小说"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddUrl_Click" />
                    <Button Grid.Column="2" Content="导入书架" Click="ImportBookshelf_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" MinHeight="24">
                <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
                <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.72" />
                <Button x:Name="ClearErrorButton"
                        Grid.Column="2"
                        Content="关闭"
                        Visibility="Collapsed"
                        Click="ClearError_Click" />
            </Grid>

            <Grid Grid.Row="3">
                <ListView x:Name="BookListView"
                          ItemsSource="{x:Bind Store.Books, Mode=OneWay}"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          SelectionChanged="BookListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Book">
                            <Grid Padding="14,13" ColumnDefinitions="48,*,Auto" ColumnSpacing="14">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="刷新目录" Tag="{x:Bind}" Click="RefreshBookCatalog_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="删除小说" Tag="{x:Bind}" Click="DeleteBook_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Border Width="44" Height="44" CornerRadius="8" Background="#172D78D4" VerticalAlignment="Top">
                                    <FontIcon Glyph="&#xE82D;" FontSize="21" Foreground="#2D78D4" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Author}" Opacity="0.62" FontSize="13" />
                                    <TextBlock Text="{x:Bind CurrentChapterTitle}" Opacity="0.78" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind LastReadDisplay}" Opacity="0.48" FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Width="156" Spacing="9" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                                        <ProgressBar Value="{x:Bind CurrentProgress}" Maximum="1" Height="3" VerticalAlignment="Center" Opacity="0.62" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProgressDisplay}" FontSize="11" Opacity="0.62" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                        <Button Content="打开" Tag="{x:Bind}" Click="OpenBook_Click" />
                                        <Button Tag="{x:Bind}" Click="DeleteBook_Click" Width="36" ToolTipService.ToolTip="删除小说">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Image Source="/Assets/AppIcon.png" Width="72" Height="72" Opacity="0.92" />
                    <TextBlock Text="书架还是空的" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="粘贴一本小说 URL，或导入 Mac 导出的 .yyreader 文件。" Opacity="0.58" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
