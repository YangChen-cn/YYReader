<Page
    x:Class="YYReader.Windows.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YYReader.Windows.Core.Models">
    <Grid Padding="28" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox x:Name="UrlTextBox"
                     PlaceholderText="粘贴小说章节或目录 URL"
                     KeyDown="UrlTextBox_KeyDown" />
            <Button Grid.Column="1" Content="添加小说" Click="AddUrl_Click" />
            <Button Grid.Column="2" Content="导入书架" Click="ImportBookshelf_Click" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" />
            <Button x:Name="ClearErrorButton"
                    Grid.Column="2"
                    Content="关闭提示"
                    Visibility="Collapsed"
                    Click="ClearError_Click" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="BookListView"
                      ItemsSource="{x:Bind Store.Books, Mode=OneWay}"
                      SelectionMode="Single"
                      SelectionChanged="BookListView_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Book">
                        <Grid Padding="12" ColumnDefinitions="*,Auto" ColumnSpacing="18">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Author}" Opacity="0.72" />
                                <TextBlock Text="{x:Bind CurrentChapterTitle}" Opacity="0.82" />
                                <TextBlock Text="{x:Bind LastReadDisplay}" Opacity="0.58" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Width="150" Spacing="6" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ProgressBar Value="{x:Bind CurrentProgress}" Maximum="1" Height="4" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ProgressDisplay}" FontSize="12" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                    <Button Content="打开" Tag="{x:Bind}" Click="OpenBook_Click" />
                                    <Button Content="删除" Tag="{x:Bind}" Click="DeleteBook_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="书架还是空的" FontSize="22" HorizontalAlignment="Center" />
                <TextBlock Text="粘贴一本小说 URL，或导入 Mac 导出的 .yyreader 文件。" Opacity="0.7" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
