<UserControl
    x:Class="YYReader.Windows.Views.AboutDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer MaxHeight="620" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="480" Spacing="20" Padding="2,4,2,2">
            <StackPanel HorizontalAlignment="Center" Spacing="8">
                <Border Width="88" Height="88" CornerRadius="20">
                    <Image Source="/Assets/AppIcon.png" Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="YYReader" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="12" Padding="10,4" HorizontalAlignment="Center">
                    <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.72" />
                </Border>
                <TextBlock Text="以正文为中心的原生 Windows 小说阅读器"
                           Style="{StaticResource YYSecondaryTextStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource YYCornerMedium}"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <FontIcon Glyph="&#xE77B;" FontSize="20" Opacity="0.65"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="作者" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="YangChen" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <HyperlinkButton NavigateUri="https://github.com/YangChen-cn/YYReader"
                                     Padding="0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon Glyph="&#xE71B;" FontSize="16" />
                            <TextBlock Text="GitHub：YangChen-cn/YYReader" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock Text="版本 1.2 重点功能" FontSize="17" FontWeight="SemiBold" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource YYCornerMedium}"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                            <FontIcon Glyph="&#xE8D2;" FontSize="17" Opacity="0.68" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="原生舒适阅读" FontWeight="SemiBold" />
                                <TextBlock Text="WinUI 原生段落渲染、稳定连续阅读、阅读位置恢复与多套阅读主题。章末通过下一章链接增量检查，不再扫描完整目录。"
                                           TextWrapping="Wrap" Style="{StaticResource YYSecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                            <FontIcon Glyph="&#xE8A5;" FontSize="17" Opacity="0.68" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="目录与离线阅读" FontWeight="SemiBold" />
                                <TextBlock Text="完整目录刷新、章节搜索、下一章预取，以及当前、后 20 章和整书下载；目录中的小点表示正文已缓存，可离线打开。"
                                           TextWrapping="Wrap" Style="{StaticResource YYSecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                            <FontIcon Glyph="&#xE895;" FontSize="17" Opacity="0.68" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Mac 与 Windows 交换" FontWeight="SemiBold" />
                                <TextBlock Text="支持书架导入导出和文件夹同步，按更新时间合并目录与阅读位置。"
                                           TextWrapping="Wrap" Style="{StaticResource YYSecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                            <FontIcon Glyph="&#xE945;" FontSize="17" Opacity="0.68" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="稳定的后台任务" FontWeight="SemiBold" />
                                <TextBlock Text="修复章末误报最新、连续阅读抖动与重复探测；目录刷新、同步和离线下载不会重建正在阅读的正文或抢走当前章节。"
                                           TextWrapping="Wrap" Style="{StaticResource YYSecondaryTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
