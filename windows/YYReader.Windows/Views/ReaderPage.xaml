<Page
    x:Class="YYReader.Windows.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:YYReader.Windows.Views">
    <Page.Resources>
        <DataTemplate x:Key="ReaderHeaderTemplate" x:DataType="local:ReaderItem">
            <StackPanel Margin="{x:Bind Margin}" Spacing="10">
                <TextBlock Text="◆" FontSize="8" Opacity="0.35" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind Text}"
                           FontSize="{x:Bind FontSize}"
                           FontFamily="{x:Bind FontFamily}"
                           Foreground="{x:Bind Foreground}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ReaderParagraphTemplate" x:DataType="local:ReaderItem">
            <TextBlock Text="{x:Bind Text}"
                       FontSize="{x:Bind FontSize}"
                       LineHeight="{x:Bind LineHeight}"
                       FontFamily="{x:Bind FontFamily}"
                       Foreground="{x:Bind Foreground}"
                       TextWrapping="Wrap"
                       IsTextSelectionEnabled="True"
                       Margin="{x:Bind Margin}" />
        </DataTemplate>
        <DataTemplate x:Key="ReaderFooterTemplate" x:DataType="local:ReaderItem">
            <TextBlock Text="{x:Bind Text}"
                       FontSize="{x:Bind FontSize}"
                       FontFamily="{x:Bind FontFamily}"
                       Foreground="{x:Bind Foreground}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="{x:Bind Margin}" />
        </DataTemplate>
        <local:ReaderItemTemplateSelector x:Key="ReaderItemSelector"
            HeaderTemplate="{StaticResource ReaderHeaderTemplate}"
            ParagraphTemplate="{StaticResource ReaderParagraphTemplate}"
            FooterTemplate="{StaticResource ReaderFooterTemplate}" />
    </Page.Resources>

    <Grid x:Name="ReaderRoot" RowDefinitions="Auto,*,Auto" SizeChanged="ReaderRoot_SizeChanged">
        <Grid Grid.Row="0" Padding="12,8" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <Button Click="Back_Click" Width="40" Height="36" ToolTipService.ToolTip="返回书架">
                <FontIcon Glyph="&#xE72B;" FontSize="15" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Spacing="1">
                <TextBlock Text="{x:Bind Store.SelectedBook.Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ToolbarChapterTitle" FontSize="11" Opacity="0.58" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ComboBox x:Name="ChapterPicker"
                      Grid.Column="2"
                      Width="170"
                      PlaceholderText="目录"
                      DisplayMemberPath="Title"
                      SelectionChanged="ChapterPicker_SelectionChanged" />
            <Button Grid.Column="3" Content="上一章" Click="PreviousChapter_Click" Height="36" />
            <Button Grid.Column="4" Content="下一章" Click="NextChapter_Click" Height="36" />
            <Button Grid.Column="5" Content="Aa" Click="Appearance_Click" Height="36" ToolTipService.ToolTip="阅读设置" />
            <Button Grid.Column="6" Width="40" Height="36" ToolTipService.ToolTip="更多">
                <FontIcon Glyph="&#xE712;" FontSize="16" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="关于原生阅读" Click="More_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <ScrollViewer x:Name="ReaderScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      ViewChanged="ReaderScrollViewer_ViewChanged"
                      KeyDown="ReaderScrollViewer_KeyDown"
                      IsTabStop="True">
            <Grid x:Name="ReaderContent" HorizontalAlignment="Center">
                <ItemsRepeater x:Name="ReaderRepeater"
                               ItemsSource="{x:Bind Items}"
                               ItemTemplate="{StaticResource ReaderItemSelector}"
                               ElementPrepared="ReaderRepeater_ElementPrepared"
                               ElementClearing="ReaderRepeater_ElementClearing">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="0" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="16,5" ColumnDefinitions="*,Auto" Opacity="0.52">
            <TextBlock x:Name="ProgressText" />
            <TextBlock Grid.Column="1" Text="PageUp / PageDown 翻页　Space 下一屏" />
        </Grid>
    </Grid>
</Page>
