<Page
    x:Class="YYReader.Windows.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YYReader.Windows.Views">
    <Page.Resources>
        <DataTemplate x:Key="ReaderHeaderTemplate" x:DataType="local:ReaderItem">
            <StackPanel Spacing="10">
                <TextBlock Text="◆" FontSize="8" Opacity="0.35" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ReaderParagraphTemplate" x:DataType="local:ReaderItem">
            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </DataTemplate>
        <DataTemplate x:Key="ReaderFooterTemplate" x:DataType="local:ReaderItem">
            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,16" />
        </DataTemplate>
        <local:ReaderItemTemplateSelector x:Key="ReaderItemSelector"
            HeaderTemplate="{StaticResource ReaderHeaderTemplate}"
            ParagraphTemplate="{StaticResource ReaderParagraphTemplate}"
            FooterTemplate="{StaticResource ReaderFooterTemplate}" />
    </Page.Resources>

    <Grid x:Name="ReaderRoot" SizeChanged="ReaderRoot_SizeChanged" KeyDown="ReaderPage_KeyDown">
        <SplitView x:Name="CatalogSplitView"
                   DisplayMode="Overlay"
                   PanePlacement="Left"
                   OpenPaneLength="340"
                   CompactPaneLength="0">
            <SplitView.Pane>
                <Border x:Name="CatalogPane" BorderThickness="0,0,1,0">
                    <Grid Padding="16,14" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Text="目录" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Width="36" Click="RefreshCatalog_Click" ToolTipService.ToolTip="刷新完整目录">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Grid.Column="2" Width="36" Click="CloseCatalog_Click" ToolTipService.ToolTip="关闭目录">
                                <FontIcon Glyph="&#xE711;" FontSize="13" />
                            </Button>
                        </Grid>
                        <TextBox x:Name="CatalogSearchBox" Grid.Row="1" PlaceholderText="搜索章节"
                                 TextChanged="CatalogSearchBox_TextChanged" />
                        <ListView x:Name="CatalogList" Grid.Row="2" SelectionMode="Single"
                                  DisplayMemberPath="Title" SelectionChanged="CatalogList_SelectionChanged" />
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="CatalogProgress" Width="16" Height="16" IsActive="False" />
                            <TextBlock x:Name="CatalogStatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="CatalogCancelButton" Content="取消" Visibility="Collapsed"
                                    Click="CancelCatalogRefresh_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" Padding="12,8" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                        <Button Click="Back_Click" Width="40" Height="36" ToolTipService.ToolTip="返回书架">
                            <FontIcon Glyph="&#xE72B;" FontSize="15" />
                        </Button>
                        <Button Grid.Column="1" Content="目录" Click="Catalog_Click" Height="36" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0" Spacing="1">
                            <TextBlock Text="{x:Bind Store.SelectedBook.Title, Mode=OneWay}" FontSize="14"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                            <TextBlock x:Name="ToolbarChapterTitle" FontSize="11" Opacity="0.58"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="3" Content="Aa" Click="Appearance_Click" Height="36" ToolTipService.ToolTip="阅读设置" />
                        <Button Grid.Column="4" Width="40" Height="36" ToolTipService.ToolTip="更多">
                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="上一章" Click="PreviousChapter_Click" />
                                    <MenuFlyoutItem Text="下一章" Click="NextChapter_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="刷新目录" Click="RefreshCatalog_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="关于原生阅读" Click="More_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <ScrollViewer x:Name="ReaderScrollViewer" Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  VerticalAnchorRatio="0" ViewChanged="ReaderScrollViewer_ViewChanged"
                                  KeyDown="ReaderScrollViewer_KeyDown" IsTabStop="True">
                        <Grid x:Name="ReaderContent" HorizontalAlignment="Center" RowDefinitions="Auto,Auto">
                            <ItemsRepeater x:Name="ReaderRepeater" ItemsSource="{x:Bind Items}"
                                           ItemTemplate="{StaticResource ReaderItemSelector}"
                                           ElementPrepared="ReaderRepeater_ElementPrepared"
                                           ElementClearing="ReaderRepeater_ElementClearing">
                                <ItemsRepeater.Layout><StackLayout Spacing="0" /></ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <Border x:Name="ContinuationBoundary" Grid.Row="1" Visibility="Collapsed"
                                    Margin="0,18,0,28" Padding="12" CornerRadius="6" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ProgressRing x:Name="ContinuationProgress" Width="16" Height="16" IsActive="False" />
                                    <TextBlock x:Name="ContinuationMessage" VerticalAlignment="Center" />
                                    <Button x:Name="ContinuationRetryButton" Content="重试" Visibility="Collapsed"
                                            Click="ContinuationRetry_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Padding="16,5" Opacity="0.48">
                        <TextBlock x:Name="ProgressText" HorizontalAlignment="Center" />
                    </Grid>
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
