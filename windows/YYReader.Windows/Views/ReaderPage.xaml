<Page
    x:Class="YYReader.Windows.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YYReader.Windows.Views"
    xmlns:models="using:YYReader.Windows.Core.Models">
    <Page.Resources>
        <DataTemplate x:Key="ReaderHeaderTemplate" x:DataType="local:ReaderItem">
            <StackPanel Spacing="10">
                <TextBlock Text="◆" FontSize="8" Opacity="0.35" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ReaderParagraphTemplate" x:DataType="local:ReaderItem">
            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </DataTemplate>
        <DataTemplate x:Key="ReaderFooterTemplate" x:DataType="local:ReaderItem">
            <StackPanel Margin="0,24,0,34" Spacing="10">
                <Border Height="1" Opacity="0.25" />
                <Grid ColumnDefinitions="*,Auto,*">
                    <Button Content="← 上一章" Tag="{x:Bind Chapter}" Click="ReaderFooterPrevious_Click"
                            HorizontalAlignment="Left" Opacity="0.72" Style="{StaticResource YYToolbarButtonStyle}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Text}" Opacity="0.5" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="下一章 →" Tag="{x:Bind Chapter}" Click="ReaderFooterNext_Click"
                            HorizontalAlignment="Right" Opacity="0.72" Style="{StaticResource YYToolbarButtonStyle}" />
                </Grid>
            </StackPanel>
        </DataTemplate>
        <local:ReaderItemTemplateSelector x:Key="ReaderItemSelector"
            HeaderTemplate="{StaticResource ReaderHeaderTemplate}"
            ParagraphTemplate="{StaticResource ReaderParagraphTemplate}"
            FooterTemplate="{StaticResource ReaderFooterTemplate}" />
    </Page.Resources>

    <Grid x:Name="ReaderRoot" SizeChanged="ReaderRoot_SizeChanged" KeyDown="ReaderPage_KeyDown">
        <SplitView x:Name="CatalogSplitView"
                   DisplayMode="Overlay"
                   PanePlacement="Left"
                   OpenPaneLength="340"
                   CompactPaneLength="0"
                   PaneOpened="CatalogSplitView_PaneOpened">
            <SplitView.Pane>
                <Border x:Name="CatalogPane" BorderThickness="0,0,1,0">
                    <Grid Padding="16,14" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Text="目录" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Width="36" Click="RefreshCatalog_Click" ToolTipService.ToolTip="刷新完整目录">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Grid.Column="2" Width="36" Click="CloseCatalog_Click" ToolTipService.ToolTip="关闭目录">
                                <FontIcon Glyph="&#xE711;" FontSize="13" />
                            </Button>
                        </Grid>
                        <TextBox x:Name="CatalogSearchBox" Grid.Row="1" PlaceholderText="搜索章节"
                                 TextChanged="CatalogSearchBox_TextChanged" />
                        <ListView x:Name="CatalogList" Grid.Row="2" SelectionMode="Single"
                                  SelectionChanged="CatalogList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Chapter">
                                    <Grid ColumnDefinitions="10,*" ColumnSpacing="7" Padding="0,3">
                                        <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                                 Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                 Opacity="{x:Bind local:ReaderPage.OfflineIndicatorOpacity(IsAvailableOffline)}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="CatalogProgress" Width="16" Height="16" IsActive="False" />
                            <TextBlock x:Name="CatalogStatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="CatalogCancelButton" Content="取消" Visibility="Collapsed"
                                    Click="CancelCatalogRefresh_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid x:Name="ReaderShell" RowDefinitions="Auto,Auto,*,Auto">
                    <Grid x:Name="ReaderToolbar" Grid.Row="0" Padding="4,0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                        <Button Click="Back_Click" Width="{StaticResource YYTitleBarButtonSize}" Height="{StaticResource YYToolbarHeight}" ToolTipService.ToolTip="返回书架">
                            <FontIcon Glyph="&#xE72B;" FontSize="15" />
                        </Button>
                        <Button Grid.Column="1" Content="目录" Click="Catalog_Click" Height="36" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0" Spacing="1"
                                    IsHitTestVisible="False">
                            <TextBlock Text="{x:Bind Store.SelectedBook.Title, Mode=OneWay}" FontSize="14"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                            <TextBlock x:Name="ToolbarChapterTitle" FontSize="11" Opacity="0.58"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="DownloadStatusButton" Grid.Column="3" Width="{StaticResource YYTitleBarButtonSize}" Height="{StaticResource YYToolbarHeight}"
                                Visibility="Collapsed" ToolTipService.ToolTip="离线下载进度">
                            <FontIcon x:Name="DownloadStatusIcon" Glyph="&#xE896;" FontSize="15" />
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Width="280" Spacing="10">
                                        <TextBlock Text="离线下载" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DownloadStatusText" TextWrapping="Wrap" />
                                        <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="1" />
                                        <Button Content="取消下载" Click="CancelDownload_Click" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="4" Content="Aa" Height="36" ToolTipService.ToolTip="阅读设置">
                            <Button.Flyout>
                                <Flyout x:Name="AppearanceFlyout" Opened="AppearanceFlyout_Opened">
                                    <StackPanel Width="360" Spacing="14">
                                        <TextBlock Text="阅读设置" FontSize="18" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Button Content="A−" Width="40" Height="34" Click="DecreaseFont_Click" />
                                            <TextBlock x:Name="AppearanceFontSizeText" Grid.Column="1"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="A+" Width="40" Height="34" Click="IncreaseFont_Click" />
                                        </Grid>
                                        <TextBlock Text="主题" Style="{StaticResource YYSecondaryTextStyle}" />
                                        <StackPanel x:Name="AppearanceThemePanel" Orientation="Horizontal" Spacing="7">
                                            <Button Tag="system" Width="36" Height="36" Padding="0" Click="AppearanceTheme_Click" ToolTipService.ToolTip="跟随系统"><FontIcon Glyph="&#xE793;" FontSize="14" /></Button>
                                            <Button Tag="light" Width="36" Height="36" Padding="0" Background="#FFFDFC" Click="AppearanceTheme_Click" ToolTipService.ToolTip="白色" />
                                            <Button Tag="sepia" Width="36" Height="36" Padding="0" Background="#F6EEDC" Click="AppearanceTheme_Click" ToolTipService.ToolTip="米黄" />
                                            <Button Tag="rose" Width="36" Height="36" Padding="0" Background="#F8E8E6" Click="AppearanceTheme_Click" ToolTipService.ToolTip="绯霞" />
                                            <Button Tag="mist" Width="36" Height="36" Padding="0" Background="#EAF0F2" Click="AppearanceTheme_Click" ToolTipService.ToolTip="雾蓝" />
                                            <Button Tag="sage" Width="36" Height="36" Padding="0" Background="#E9EFE5" Click="AppearanceTheme_Click" ToolTipService.ToolTip="草木" />
                                            <Button Tag="dark" Width="36" Height="36" Padding="0" Background="#252525" Click="AppearanceTheme_Click" ToolTipService.ToolTip="暗色" />
                                            <Button Tag="midnight" Width="36" Height="36" Padding="0" Background="#111820" Click="AppearanceTheme_Click" ToolTipService.ToolTip="深夜" />
                                        </StackPanel>
                                        <TextBlock Text="字体" Style="{StaticResource YYSecondaryTextStyle}" />
                                        <RadioButtons x:Name="AppearanceFontOptions" MaxColumns="3" SelectionChanged="AppearanceControl_Changed">
                                            <x:String>宋体</x:String><x:String>黑体</x:String><x:String>楷体</x:String>
                                        </RadioButtons>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="行距" Style="{StaticResource YYSecondaryTextStyle}" />
                                                <RadioButtons x:Name="AppearanceLineOptions" MaxColumns="3" SelectionChanged="AppearanceControl_Changed">
                                                    <x:String>紧凑</x:String><x:String>舒适</x:String><x:String>宽松</x:String>
                                                </RadioButtons>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="正文宽度" Style="{StaticResource YYSecondaryTextStyle}" />
                                                <RadioButtons x:Name="AppearanceWidthOptions" MaxColumns="3" SelectionChanged="AppearanceControl_Changed">
                                                    <x:String>窄</x:String><x:String>舒适</x:String><x:String>宽</x:String>
                                                </RadioButtons>
                                            </StackPanel>
                                        </Grid>
                                        <ToggleSwitch x:Name="AppearanceIndentToggle" Header="段首缩进" Toggled="AppearanceControl_Changed" />
                                        <ToggleSwitch x:Name="AppearanceContinuousToggle" Header="连续阅读" Toggled="AppearanceControl_Changed" />
                                        <Expander Header="更多阅读设置">
                                            <StackPanel Spacing="8" Padding="0,8,0,0">
                                                <TextBlock Text="段距" Style="{StaticResource YYSecondaryTextStyle}" />
                                                <RadioButtons x:Name="AppearanceParagraphOptions" MaxColumns="3" SelectionChanged="AppearanceControl_Changed">
                                                    <x:String>紧凑</x:String><x:String>舒适</x:String><x:String>宽松</x:String>
                                                </RadioButtons>
                                                <ToggleSwitch x:Name="AppearancePrefetchToggle" Header="空闲时预取下一章" Toggled="AppearanceControl_Changed" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="5" Width="{StaticResource YYTitleBarButtonSize}" Height="{StaticResource YYToolbarHeight}" ToolTipService.ToolTip="更多">
                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="刷新目录" Click="RefreshCatalog_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="下载当前章节" Click="DownloadCurrentChapter_Click" />
                                    <MenuFlyoutItem Text="下载后 20 章" Click="DownloadNext20_Click" />
                                    <MenuFlyoutItem Text="下载全部章节" Click="DownloadAll_Click" />
                                    <MenuFlyoutItem Text="取消下载" Click="CancelDownload_Click" />
                                    <MenuFlyoutItem Text="删除离线缓存" Click="ClearOfflineCache_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="关于 YYReader" Click="More_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <InfoBar x:Name="ReaderInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True"
                             Margin="12,6" HorizontalAlignment="Stretch" />

                    <ScrollViewer x:Name="ReaderScrollViewer" Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  VerticalAnchorRatio="0" ViewChanged="ReaderScrollViewer_ViewChanged"
                                  KeyDown="ReaderScrollViewer_KeyDown" IsTabStop="True">
                        <Grid x:Name="ReaderContent" HorizontalAlignment="Center" RowDefinitions="Auto,Auto">
                            <ItemsRepeater x:Name="ReaderRepeater" ItemsSource="{x:Bind Items}"
                                           ItemTemplate="{StaticResource ReaderItemSelector}"
                                           ElementPrepared="ReaderRepeater_ElementPrepared"
                                           ElementClearing="ReaderRepeater_ElementClearing">
                                <ItemsRepeater.Layout><StackLayout Spacing="0" /></ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <Border x:Name="ContinuationBoundary" Grid.Row="1" Visibility="Collapsed"
                                    Width="300" Height="72" Margin="0,18,0,28" Padding="12"
                                    CornerRadius="6" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ProgressRing x:Name="ContinuationProgress" Width="16" Height="16" IsActive="False" />
                                    <TextBlock x:Name="ContinuationMessage" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    <Button x:Name="ContinuationRetryButton" Content="重试"
                                            Click="ContinuationRetry_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Padding="16,5" Opacity="0.48">
                        <TextBlock x:Name="ProgressText" HorizontalAlignment="Center" />
                    </Grid>
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
