{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YangChen-cn/YYReader/blob/main/shared/sync/sync-snapshot-v1.schema.json",
  "title": "YYReader SyncSnapshot v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "device", "updatedAt", "books"],
  "properties": {
    "format": { "const": "yyreader-sync" },
    "version": { "const": 1 },
    "device": { "enum": ["mac", "windows"] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "books": {
      "type": "array",
      "items": { "$ref": "#/$defs/book" }
    }
  },
  "$defs": {
    "book": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sourceURL", "title", "author", "updatedAt"],
      "properties": {
        "sourceURL": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "currentChapterURL": { "type": ["string", "null"], "format": "uri" },
        "paragraphIndex": { "type": ["integer", "null"], "minimum": 0 },
        "progress": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "lastReadAt": { "type": ["string", "null"], "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
